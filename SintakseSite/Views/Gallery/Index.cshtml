@model IEnumerable<SintakseSite.Models.GalleryViewModel>

@{
    ViewData["Title"] = "Pasākumu galerija";
    ViewData["Description"] = "Fotogrāfijas no Sintakses Stupora dzejas lasījumiem, performancēm un literārajām satikšanās reizēm.";
    ViewData["CanonicalPath"] = Url.Action("Index", "Gallery");
    var galleries = Model.OrderByDescending(g => g.Date).ThenBy(g => g.Title).ToList();
    var socialGallery = galleries.FirstOrDefault(g => !string.IsNullOrWhiteSpace(g.CoverImage));
    ViewData["SocialImage"] = socialGallery?.CoverImage;
    ViewData["SocialImageAlt"] = socialGallery?.Title ?? "Sintakses Stupors";
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery-index.css" asp-append-version="true" />
}

<section class="gallery-index-page">
    <div class="gallery-index-container">

        <a asp-controller="Home"
           asp-action="Index"
           class="gallery-home-link">
            <span aria-hidden="true">←</span>
            Uz sākumlapu
        </a>

        <header class="gallery-index-heading">
            <p class="eyebrow">
                Sintakses Stupors
            </p>

            <h1>Galerija</h1>

            <p class="intro">
                Dzejas lasījumi, performances un mirkļi starp rindām.
            </p>
        </header>

        @if (!galleries.Any())
        {
            <p class="gallery-empty">
                Galerijas vēl nav pievienotas.
            </p>
        }
        else
        {
            <div class="gallery-albums">
                @foreach (var gallery in galleries)
                {
                    <article class="gallery-album">

                        <a asp-controller="Gallery"
                           asp-action="Details"
                           asp-route-slug="@gallery.Slug"
                           class="gallery-cover-link"
                           aria-label="Atvērt galeriju: @gallery.Title">

                            <img src="@gallery.CoverImage"
                                 alt="@gallery.Title"
                                 loading="@(gallery == galleries[0] ? "eager" : "lazy")"
                                 decoding="async" />
                        </a>

                        <div class="gallery-album-content">
                            <time datetime="@gallery.Date.ToString("yyyy-MM-dd")">
                                @gallery.Date.ToString("dd.MM.yyyy")
                            </time>

                            <h2>
                                @gallery.Title
                            </h2>

                            <p class="gallery-description">@gallery.Description</p>
                            <p class="gallery-media-count">
                                <span>Foto: @gallery.Images.Count</span>
                                @if (gallery.Videos.Any())
                                {
                                    <span>Video: @gallery.Videos.Count</span>
                                }
                            </p>

                            <a asp-controller="Gallery"
                               asp-action="Details"
                               asp-route-slug="@gallery.Slug"
                               class="gallery-open-button"
                               aria-label="Skatīt galeriju: @gallery.Title">
                                Skatīt galeriju
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>

                    </article>
                }
            </div>
        }

    </div>
</section>