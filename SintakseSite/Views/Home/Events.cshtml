@model SintakseSite.Models.HomePageViewModel
@{
    ViewData["Title"] = "Pasākumi";
    ViewData["CanonicalPath"] = "/pasakumi";
    ViewData["Description"] = "Gaidāmie Sintakses Stupora pasākumi un iepriekšējo notikumu arhīvs.";
}
<style>
    
    .poster-button {
        position: relative;
        display: block;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        overflow: hidden;
        cursor: zoom-in;
    }

    .poster-image {
        display: block;
        width: 300px;
        height: auto;
        border-radius: 6px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
        transition: transform 0.3s ease;
    }

    .poster-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: rgba(0, 0, 0, 0.35);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .poster-icon {
        display: flex;
        width: 54px;
        height: 54px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        color: #171717;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        transform: scale(0.9);
        transition: transform 0.3s ease;
    }

    .poster-button:hover .poster-image {
        transform: scale(1.03);
    }

    .poster-button:hover .poster-overlay {
        opacity: 1;
    }

    .poster-button:hover .poster-icon {
        transform: scale(1);
    }

    .author-frame {
        width: 280px;
        height: 373px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 4px;
    }

    .author-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0);
        opacity: 1;
        transform: scale(1);
        transition: filter 0.7s ease, opacity 0.7s ease, transform 0.7s ease;
    }

    /* Datorā attēli melnbalti */
    @@media (min-width: 768px) {
        .author-image {
            filter: grayscale(100%);
            opacity: 0.9;
        }

        .author-card:hover .author-image {
            filter: grayscale(0);
            opacity: 1;
            transform: scale(1.02);
        }
    }
</style>
<section id="pasakumi"
         class="border-t border-neutral-200 bg-white px-6 py-32">

    <div class="mx-auto max-w-6xl">

        <div class="mb-20 text-center">
            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                Pasākumi
            </p>

            <h1 class="mt-6 text-5xl font-light tracking-tight text-neutral-950 md:text-7xl">
                Tuvākie notikumi
            </h1>
        </div>

        @if (Model.UpcomingEvents.Any())
        {
            <div class="space-y-32 lg:space-y-20">
                @foreach (var eventItem in Model.UpcomingEvents)
                {
                    <article class="ss-event-layout">

                        <div class="flex justify-center">
                            <button type="button"
                                    onclick="openPoster('@eventItem.PosterImage')"
                                    aria-label="Palielināt @eventItem.Title afišu"
                                    class="poster-button">

                                <img src="@eventItem.PosterImage"
                                     alt="@eventItem.Title afiša"
                                     class="poster-image" />

                                <span class="poster-overlay">
                                    <span class="poster-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">

                                            <circle cx="11" cy="11" r="7"></circle>
                                            <line x1="20"
                                                  y1="20"
                                                  x2="16.5"
                                                  y2="16.5">
                                            </line>
                                        </svg>
                                    </span>
                                </span>
                            </button>
                        </div>

                        <div>
                            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                                @eventItem.Date.ToString("dd.MM.yyyy")
                                @if (!string.IsNullOrWhiteSpace(eventItem.Time))
                                {
                                    <span> · @eventItem.Time</span>
                                }
                            </p>

                            <h3 class="mt-5 text-4xl font-light leading-tight text-neutral-950 md:text-5xl">
                                @eventItem.Title
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(eventItem.LocationName) || !string.IsNullOrWhiteSpace(eventItem.PriceText))
                            {
                                <dl class="ss-event-facts">
                                    @if (!string.IsNullOrWhiteSpace(eventItem.LocationName))
                                    {
                                        <div><dt>Vieta</dt><dd>@eventItem.LocationName</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(eventItem.PriceText))
                                    {
                                        <div><dt>Ieeja</dt><dd>@eventItem.PriceText</dd></div>
                                    }
                                </dl>
                            }
                            <p class="ss-event-summary">@eventItem.PreviewText</p>
                            <div class="ss-event-more">
                                <a asp-controller="Events" asp-action="Details" asp-route-slug="@eventItem.Slug"
                                   class="ss-button ss-button-primary">Plašāk par pasākumu <span aria-hidden="true">→</span></a>
                            </div>
                        </div>

                    </article>
                }
            </div>
        }
        else
        {
            <p class="text-center text-lg text-neutral-500">
                Pašlaik jauni pasākumi nav izziņoti.
            </p>
        }

    </div>
</section>
<section id="arhivs" class="ss-archive-section">
    <div class="mx-auto max-w-6xl">
        @if (Model.PastEvents.Any())
        {
            <div class="border-y border-neutral-200 bg-neutral-100 px-6 py-20">

                <div class="mb-16 text-center">
                    <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                        Arhīvs
                    </p>

                    <h3 class="mt-5 text-4xl font-light text-neutral-950 md:text-5xl">
                        Notikušie pasākumi
                    </h3>
                </div>

                <div class="divide-y divide-neutral-200">

                    @foreach (var eventItem in Model.PastEvents)
                    {
                        <article class="grid gap-6 py-8 md:grid-cols-[160px_1fr_auto] md:items-center">

                            <div>
                                <p class="text-sm uppercase tracking-[0.2em] text-red-700">
                                    @eventItem.Date.ToString("dd.MM.yyyy")
                                </p>

                                <p class="mt-2 text-sm text-neutral-500">
                                    @eventItem.Time
                                </p>
                            </div>

                            <div>
                                <h4 class="text-3xl font-light text-neutral-950">
                                    @eventItem.Title
                                </h4>

                                    <p class="mt-3 max-w-2xl leading-7 text-neutral-600">
                                        @eventItem.Description
                                    </p>
                                </div>

                                <div>
                                    @if (!string.IsNullOrWhiteSpace(eventItem.GallerySlug))
                                    {
                                        <a asp-controller="Gallery"
                                        asp-action="Details"
                                        asp-route-slug="@eventItem.GallerySlug"
                                        class="inline-flex items-center gap-3 border border-neutral-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-neutral-700 transition-all duration-300 hover:border-red-700 hover:bg-red-700 hover:text-white">

                                            Skatīt galeriju

                                            <span aria-hidden="true"
                                            class="transition-transform duration-300 hover:translate-x-1">
                                                →
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-sm uppercase tracking-[0.35em] text-neutral-400">
                                            Galerija drīzumā
                                        </span>
                                    }
                                </div>

                            </article>
                        }

                    </div>
                </div>
            }

        </div>
    </section>
<div id="posterModal"
     onclick="closePoster()"
     style="
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0,0,0,0.88);
    cursor: zoom-out;
    ">

    <button type="button"
            onclick="closePoster()"
            aria-label="Aizvērt afišu"
            style="
        position: fixed;
        top: 20px;
        right: 24px;
        border: none;
        background: transparent;
        color: white;
        font-size: 36px;
        cursor: pointer;
        ">
        ×
    </button>

    <img id="posterModalImage"
         src=""
         alt="Palielināta pasākuma afiša"
         onclick="event.stopPropagation()"
         style="
    display: block;
    max-width: 95vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    cursor: default;
    " />
</div>

<script>
    function openPoster(imagePath) {
        const modal = document.getElementById("posterModal");
        const image = document.getElementById("posterModalImage");

        image.src = imagePath;
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
    }

    function closePoster() {
        const modal = document.getElementById("posterModal");

        modal.style.display = "none";
        document.body.style.overflow = "";
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closePoster();
        }
    });
</script>

