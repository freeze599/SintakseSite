@model SintakseSite.Models.HomePageViewModel

@{
    ViewData["Title"] = "Sākums";
    var featuredEvent = Model.UpcomingEvents.OrderBy(e => e.Date).FirstOrDefault();
    ViewData["Description"] = "Iepazīsti Sintakses Stupora autorus, uzzini par tuvākajiem dzejas lasījumiem un apskati fotogrāfijas no mūsu pasākumiem.";
    ViewData["CanonicalPath"] = "/";
    ViewData["SocialImage"] = featuredEvent?.PosterImage;
    ViewData["SocialImageAlt"] = featuredEvent is null
        ? "Sintakses Stupors"
        : featuredEvent.Title + " — pasākuma afiša";
}


@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<style>
    
    .poster-button {
        position: relative;
        display: block;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        overflow: hidden;
        cursor: zoom-in;
    }

    .poster-image {
        display: block;
        width: 300px;
        height: auto;
        border-radius: 6px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
        transition: transform 0.3s ease;
    }

    .poster-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: rgba(0, 0, 0, 0.35);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .poster-icon {
        display: flex;
        width: 54px;
        height: 54px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        color: #171717;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        transform: scale(0.9);
        transition: transform 0.3s ease;
    }

    .poster-button:hover .poster-image {
        transform: scale(1.03);
    }

    .poster-button:hover .poster-overlay {
        opacity: 1;
    }

    .poster-button:hover .poster-icon {
        transform: scale(1);
    }

    .author-frame {
        width: 280px;
        height: 373px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 4px;
    }

    .author-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0);
        opacity: 1;
        transform: scale(1);
        transition: filter 0.7s ease, opacity 0.7s ease, transform 0.7s ease;
    }

    /* Datorā attēli melnbalti */
    @@media (min-width: 768px) {
        .author-image {
            filter: grayscale(100%);
            opacity: 0.9;
        }

        .author-card:hover .author-image {
            filter: grayscale(0);
            opacity: 1;
            transform: scale(1.02);
        }
    }
</style>

<header class="ss-header">
    <div class="ss-shell ss-header-inner">
        <a class="ss-brand" href="#sakums" aria-label="Sintakses Stupors — sākums">
            <img src="/images/slogo3.png" alt="" width="395" height="497" />
            <span>Sintakses<br /><strong>Stupors</strong></span>
        </a>
        <nav class="ss-nav" aria-label="Galvenā navigācija">
            <a href="#pasakumi">Pasākumi</a>
            <a href="#autori">Autori</a>
            <a asp-controller="Gallery" asp-action="Index">Galerija</a>
            <a href="#par-mums">Par mums</a>
            <a href="#kontakti">Kontakti</a>
        </nav>
    </div>
</header>

<section id="sakums" class="ss-intro" aria-labelledby="ss-title">
    <div class="ss-shell ss-intro-grid">
        <div class="ss-intro-copy">
            <p class="ss-eyebrow">Dzeja · cilvēki · satikšanās</p>
            <h1 id="ss-title" class="hero-title">Sintakses<br /><span>Stupors</span></h1>
            <p class="ss-lead">Vieta literatūrai, autoriem un notikumiem.</p>
            <p class="ss-intro-note">Rīkojam dzejas lasījumus, dalāmies tekstos un plānojam būt mūžīgi.</p>
            <div class="ss-actions">
                <a class="ss-button ss-button-primary" href="#pasakumi">
                    @(featuredEvent is null ? "Skatīt pasākumus" : "Tuvākais pasākums") <span aria-hidden="true">↓</span>
                </a>
                <a class="ss-text-link" href="#autori">Iepazīsti autorus <span aria-hidden="true">→</span></a>
            </div>
        </div>
        @if (featuredEvent is not null)
        {
            <article class="ss-feature" aria-labelledby="ss-feature-title">
                <div class="ss-feature-topline"><span>Tiekamies drīzumā</span><span aria-hidden="true">↗</span></div>
                @if (!string.IsNullOrWhiteSpace(featuredEvent.PosterImage))
                {
                    <a class="ss-feature-image" href="#pasakumi" aria-label="Skatīt pasākumu: @featuredEvent.Title">
                        <img src="@featuredEvent.PosterImage" alt="@featuredEvent.Title afiša" fetchpriority="high" />
                    </a>
                }
                <div class="ss-feature-body">
                    <p class="ss-event-date">
                        <time datetime="@featuredEvent.Date.ToString("yyyy-MM-dd")">@featuredEvent.Date.ToString("dd.MM.yyyy")</time>
                        @if (!string.IsNullOrWhiteSpace(featuredEvent.Time))
                        {
                            <span> · @featuredEvent.Time</span>
                        }
                    </p>
                    <h2 id="ss-feature-title" class="hero-title">@featuredEvent.Title</h2>
                    <a class="ss-text-link" href="#pasakumi">Par pasākumu <span aria-hidden="true">→</span></a>
                </div>
            </article>
        }
        else
        {
            <div class="ss-feature ss-feature-empty">
                <p class="ss-eyebrow">Starp satikšanās reizēm</p>
                <h2 class="hero-title">Dzeja paliek.</h2>
                <p>Nākamos pasākumus vēl gatavojam. Tikmēr ieskaties mūsu kopīgajos brīžos.</p>
                <a class="ss-button ss-button-primary" asp-controller="Gallery" asp-action="Index">Skatīt galeriju <span aria-hidden="true">→</span></a>
            </div>
        }
    </div>
    <div class="ss-shell ss-intro-footer"><span>Literatūrā kopā kopš 2024.</span><a href="#par-mums">Mūsu stāsts <span aria-hidden="true">↓</span></a></div>
</section>

<section id="pasakumi"
         class="border-t border-neutral-200 bg-white px-6 py-32">

    <div class="mx-auto max-w-6xl">

        <div class="mb-20 text-center">
            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                Pasākumi
            </p>

            <h2 class="mt-6 text-5xl font-light tracking-tight text-neutral-950 md:text-7xl">
                Tuvākie notikumi
            </h2>
        </div>

        @if (Model.UpcomingEvents.Any())
        {
            <div class="space-y-32 lg:space-y-20">
                @foreach (var eventItem in Model.UpcomingEvents)
                {
                    <article class="ss-event-layout">

                        <div class="flex justify-center">
                            <button type="button"
                                    onclick="openPoster('@eventItem.PosterImage')"
                                    aria-label="Palielināt @eventItem.Title afišu"
                                    class="poster-button">

                                <img src="@eventItem.PosterImage"
                                     alt="@eventItem.Title afiša"
                                     class="poster-image" />

                                <span class="poster-overlay">
                                    <span class="poster-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             aria-hidden="true">

                                            <circle cx="11" cy="11" r="7"></circle>
                                            <line x1="20"
                                                  y1="20"
                                                  x2="16.5"
                                                  y2="16.5">
                                            </line>
                                        </svg>
                                    </span>
                                </span>
                            </button>
                        </div>

                        <div>
                            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                                @eventItem.Date.ToString("dd.MM.yyyy")
                                ·
                                @eventItem.Time
                            </p>

                            <h3 class="mt-5 text-4xl font-light leading-tight text-neutral-950 md:text-5xl">
                                @eventItem.Title
                            </h3>

                            <div class="ss-event-description mt-6 text-lg leading-8 text-neutral-600">
                                @foreach (var paragraph in eventItem.Description.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <p>@paragraph.Trim()</p>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(eventItem.Participants))
                            {
                                <div class="mt-8">
                                    <p class="text-sm uppercase tracking-[0.25em] text-red-700">
                                        Dzeju lasīs
                                    </p>

                                    <p class="mt-4 leading-8 text-neutral-600">
                                        @eventItem.Participants
                                    </p>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(eventItem.MusicalGuest))
                            {
                                <div class="mt-8">
                                    <p class="text-sm uppercase tracking-[0.25em] text-red-700">
                                        Muzikālais viesis
                                    </p>

                                    <p class="mt-4 text-lg text-neutral-700">
                                        @eventItem.MusicalGuest
                                    </p>
                                </div>
                            }

                            <div class="mt-10 flex flex-wrap gap-4">

                                @if (!string.IsNullOrWhiteSpace(eventItem.LocationUrl))
                                {
                                    <a href="@eventItem.LocationUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="inline-flex items-center gap-3 border border-neutral-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-neutral-700 transition-all duration-300 hover:border-red-700 hover:bg-red-700 hover:text-white">

                                        Atrašanās vieta
                                        <span aria-hidden="true">↗</span>
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(eventItem.ExternalUrl))
                                {
                                    <a href="@eventItem.ExternalUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="inline-flex items-center gap-3 border border-neutral-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-neutral-700 transition-all duration-300 hover:border-red-700 hover:bg-red-700 hover:text-white">

                                        @eventItem.ExternalLinkText
                                        <span aria-hidden="true">→</span>
                                    </a>
                                }
                                </div>
                                </div>

                    </article>
                }
            </div>
        }
        else
        {
            <p class="text-center text-lg text-neutral-500">
                Pašlaik jauni pasākumi nav izziņoti.
            </p>
        }

    </div>
</section>

<section id="par-mums" class="border-t border-neutral-200 bg-stone-50 px-6 py-32">
    <div class="mx-auto grid max-w-6xl gap-16 md:grid-cols-[0.8fr_1.2fr]">

        <div>
            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                Par mums
            </p>

            <h2 class="hero-title mt-6 text-4xl font-light leading-tight text-neutral-950 md:text-6xl">
                Esam jau no 2024. gada
            </h2>
        </div>

        <div class="space-y-6 text-lg leading-8 text-neutral-700">
            <p>
                Sintakses Stupors ir aizrautīgu domubiedru uzturēta dzejas grupa, kurā rakstošie var dalīties ar saviem dzejoļiem un citiem tekstiem, savukārt lasošie – ar tiem baroties.
            </p>

            <p>
                Mēs rīkojam dzejas lasījumus, radošas tikšanās, pasākumus, publicējam savus tekstus un plānojam būt mūžīgi.
            </p>

            <p>
                Šī ir vieta mūsu autoriem, notikumiem, galerijām un kopīgajam ceļam literatūrā.
            </p>
        </div>

    </div>
</section>

<section id="autori"
         class="border-t border-neutral-200 bg-white px-6 py-32">

    <div class="mx-auto max-w-6xl">

        <div class="mb-16 text-center">
            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                Autori
            </p>
        </div>

        <div class="grid gap-x-10 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
            
            @foreach (var author in Model.Authors)
            {
                var hasDescription = !string.IsNullOrWhiteSpace(author.Description);

                <article class="author-card text-center">

                    @if (hasDescription)
                    {
                        <div class="author-book-card"
                             data-author-card>

                            <div class="author-book-content author-frame">

                                <div class="author-book-description"
                                     aria-hidden="true">

                                    <div class="author-book-description-inner">

                                        <h3 class="author-book-title">
                                            @author.Name
                                        </h3>

                                        <div class="author-book-text">
                                            @foreach (var paragraph in author.Description!
                                                .Split(
                                                    new[] { "\r\n\r\n", "\n\n" },
                                                    StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <p>@paragraph.Trim()</p>
                                            }
                                        </div>

                                        <button type="button"
                                                class="author-book-close"
                                                data-author-close>
                                            ← Atpakaļ
                                        </button>

                                    </div>
                                </div>

                                <button type="button"
                                        class="author-book-cover"
                                        data-author-open
                                        aria-label="Atvērt aprakstu par @author.Name"
                                        aria-expanded="false">

                                    <img src="/images/Autori/@author.Image"
                                         alt="@author.Name"
                                         loading="lazy"
                                         style="object-position: @author.ObjectPosition;"
                                         class="author-image" />

                                    <span class="author-book-hint">
                                        Lasīt aprakstu
                                    </span>

                                </button>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="author-frame">

                            <img src="/images/Autori/@author.Image"
                                 alt="@author.Name"
                                 loading="lazy"
                                 style="object-position: @author.ObjectPosition;"
                                 class="author-image" />

                        </div>
                    }

                    <h3 class="mt-4 text-2xl text-neutral-950">
                        @author.Name
                    </h3>

                    <p class="mt-1 text-neutral-500">
                        @author.Categories
                    </p>

                </article>
            }
            

        </div>
    </div>
</section>

   
<section id="gallery" class="border-t border-neutral-200 bg-white px-6 py-32">

    <div class="mx-auto max-w-6xl">

        <div class="mb-20 text-center">

            <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                Galerija
            </p>

            <h2 class="mt-6 text-5xl md:text-7xl font-light tracking-tight text-neutral-950">
                Atskats uz pasākumiem
            </h2>

            <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-neutral-600">
                Fotogrāfijas no Sintakses Stupora projektiem
            </p>

            <a asp-controller="Gallery"
               asp-action="Index"
               class="mt-12 inline-flex items-center gap-3 border border-neutral-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-neutral-700 transition-all duration-300 hover:border-red-700 hover:bg-red-700 hover:text-white">

                Skatīt galeriju
                <span aria-hidden="true">→</span>

            </a>

        </div>

    </div>

</section>
<section id="arhivs" class="ss-archive-section">
    <div class="mx-auto max-w-6xl">
        @if (Model.PastEvents.Any())
        {
            <div class="border-y border-neutral-200 bg-neutral-100 px-6 py-20">

                <div class="mb-16 text-center">
                    <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                        Arhīvs
                    </p>

                    <h3 class="mt-5 text-4xl font-light text-neutral-950 md:text-5xl">
                        Notikušie pasākumi
                    </h3>
                </div>

                <div class="divide-y divide-neutral-200">

                    @foreach (var eventItem in Model.PastEvents)
                    {
                        <article class="grid gap-6 py-8 md:grid-cols-[160px_1fr_auto] md:items-center">

                            <div>
                                <p class="text-sm uppercase tracking-[0.2em] text-red-700">
                                    @eventItem.Date.ToString("dd.MM.yyyy")
                                </p>

                                <p class="mt-2 text-sm text-neutral-500">
                                    @eventItem.Time
                                </p>
                            </div>

                            <div>
                                <h4 class="text-3xl font-light text-neutral-950">
                                    @eventItem.Title
                                </h4>

                                    <p class="mt-3 max-w-2xl leading-7 text-neutral-600">
                                        @eventItem.Description
                                    </p>
                                </div>

                                <div>
                                    @if (!string.IsNullOrWhiteSpace(eventItem.GallerySlug))
                                    {
                                        <a asp-controller="Gallery"
                                        asp-action="Details"
                                        asp-route-slug="@eventItem.GallerySlug"
                                        class="inline-flex items-center gap-3 border border-neutral-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-neutral-700 transition-all duration-300 hover:border-red-700 hover:bg-red-700 hover:text-white">

                                            Skatīt galeriju

                                            <span aria-hidden="true"
                                            class="transition-transform duration-300 hover:translate-x-1">
                                                →
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-sm uppercase tracking-[0.35em] text-neutral-400">
                                            Galerija drīzumā
                                        </span>
                                    }
                                </div>

                            </article>
                        }

                    </div>
                </div>
            }

        </div>
    </section>

    <section id="kontakti"
             class="border-t border-neutral-200 bg-stone-50 px-6 py-32">

        <div class="mx-auto max-w-5xl">

            <div class="text-center">
                <p class="text-sm uppercase tracking-[0.35em] text-red-700">
                    Atrodi mūs
                </p>

                <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-neutral-600">
                    Jaunākie dzejoļi, pasākumi un citas aktualitātes atrodamas
                    mūsu sociālajos tīklos.
                </p>
            </div>

        <div class="mx-auto mt-16 max-w-3xl space-y-4">

            <!-- Instagram -->
            <a href="https://www.instagram.com/sintaksesstupors/"
               target="_blank"
               rel="noopener noreferrer"
               class="group relative flex items-center justify-between gap-5 overflow-hidden rounded-sm border border-neutral-200 bg-white/50 px-6 py-7 transition-all duration-300 hover:-translate-y-0.5 hover:border-red-700 hover:bg-white hover:shadow-lg sm:gap-8 sm:px-7">

                <span class="absolute inset-y-0 left-0 w-1 bg-red-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>

                <div class="flex min-w-0 items-center gap-4 text-left sm:gap-5">

                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 text-neutral-600 transition-all duration-300 group-hover:border-red-700 group-hover:text-red-700">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="22"
                             height="22"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <rect x="3"
                                  y="3"
                                  width="18"
                                  height="18"
                                  rx="5">
                            </rect>

                            <circle cx="12"
                                    cy="12"
                                    r="4">
                            </circle>

                            <circle cx="17.5"
                                    cy="6.5"
                                    r="1">
                            </circle>

                        </svg>

                    </span>

                    <div class="min-w-0">
                        <p class="text-xs uppercase tracking-[0.3em] text-neutral-400 transition-colors duration-300 group-hover:text-red-700">
                            Instagram
                        </p>

                        <p class="mt-2 truncate text-xl font-light text-neutral-950 transition-colors duration-300 group-hover:text-red-700 md:text-2xl">
                            @@sintaksesstupors
                        </p>
                    </div>

                </div>

                <span class="shrink-0 text-3xl text-neutral-400 transition-all duration-300 group-hover:translate-x-2 group-hover:text-red-700"
                      aria-hidden="true">
                    →
                </span>

            </a>

            <!-- Facebook -->
            <a href="https://www.facebook.com/groups/937678954475837"
               target="_blank"
               rel="noopener noreferrer"
               class="group relative flex items-center justify-between gap-5 overflow-hidden rounded-sm border border-neutral-200 bg-white/50 px-6 py-7 transition-all duration-300 hover:-translate-y-0.5 hover:border-red-700 hover:bg-white hover:shadow-lg sm:gap-8 sm:px-7">

                <span class="absolute inset-y-0 left-0 w-1 bg-red-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>

                <div class="flex min-w-0 items-center gap-4 text-left sm:gap-5">

                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-neutral-300 text-neutral-600 transition-all duration-300 group-hover:border-red-700 group-hover:text-red-700">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="22"
                             height="22"
                             viewBox="0 0 24 24"
                             fill="currentColor"
                             aria-hidden="true">

                            <path d="M13.5 22v-8h2.8l.4-3.2h-3.2V8.75c0-.93.26-1.56 1.6-1.56H16.8V4.32c-.3-.04-1.32-.13-2.5-.13-2.47 0-4.17 1.51-4.17 4.29v2.32H7.33V14h2.8v8h3.37Z" />

                        </svg>

                    </span>

                    <div class="min-w-0">
                        <p class="text-xs uppercase tracking-[0.3em] text-neutral-400 transition-colors duration-300 group-hover:text-red-700">
                            Facebook
                        </p>

                        <p class="mt-2 truncate text-xl font-light text-neutral-950 transition-colors duration-300 group-hover:text-red-700 md:text-2xl">
                            Sintakses Stupors
                        </p>
                    </div>
                    
                </div>

                <span class="shrink-0 text-3xl text-neutral-400 transition-all duration-300 group-hover:translate-x-2 group-hover:text-red-700"
                      aria-hidden="true">
                    →
                </span>
               
            </a>

        </div>
        <partial name="_CompanyDetails" />
    </div>
</section>
<footer class="border-t border-neutral-200 bg-neutral-950 px-6 py-12 text-neutral-300">
    <div class="mx-auto max-w-6xl">

        <div class="mx-auto h-px max-w-3xl bg-neutral-800"></div>

        <div class="mt-10 flex flex-col items-center text-center">

            <p class="text-xs uppercase tracking-[0.3em] text-neutral-500">
                Mājaslapas izstrāde
            </p>

            <p class="mt-4 text-lg text-black">
                Arnolds Ščuckis
            </p>

            <a href="mailto:arnolds.scuckis@inbox.lv"
               class="mt-3 text-sm text-neutral-400 transition duration-300 hover:text-white">
                arnolds.scuckis@inbox.lv
            </a>

            <p class="mt-8 text-sm text-neutral-500">
                © @DateTime.Now.Year Sintakses Stupors
            </p>

        </div>
    </div>
</footer>


<button id="backToTop"
        type="button"
        aria-label="Atgriezties lapas augšpusē"
        style="
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 48px;
    height: 48px;
    border: 1px solid #d4d4d4;
    border-radius: 9999px;
    background: white;
    color: #404040;
    font-size: 24px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    cursor: pointer;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.3s ease;
    ">
    ↑
</button>


    
<script>
    const backToTopButton = document.getElementById("backToTop");

    function updateBackToTopButton() {
        if (window.scrollY > 400) {
            backToTopButton.style.opacity = "1";
            backToTopButton.style.visibility = "visible";
            backToTopButton.style.pointerEvents = "auto";
        } else {
            backToTopButton.style.opacity = "0";
            backToTopButton.style.visibility = "hidden";
            backToTopButton.style.pointerEvents = "none";
        }
    }

    window.addEventListener("scroll", updateBackToTopButton);

    backToTopButton.addEventListener("click", function () {
        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    });

    updateBackToTopButton();
</script>

<div id="posterModal"
     onclick="closePoster()"
     style="
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0,0,0,0.88);
    cursor: zoom-out;
    ">

    <button type="button"
            onclick="closePoster()"
            aria-label="Aizvērt afišu"
            style="
        position: fixed;
        top: 20px;
        right: 24px;
        border: none;
        background: transparent;
        color: white;
        font-size: 36px;
        cursor: pointer;
        ">
        ×
    </button>

    <img id="posterModalImage"
         src=""
         alt="Palielināta pasākuma afiša"
         onclick="event.stopPropagation()"
         style="
    display: block;
    max-width: 95vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    cursor: default;
    " />
</div>

<script>
    function openPoster(imagePath) {
        const modal = document.getElementById("posterModal");
        const image = document.getElementById("posterModalImage");

        image.src = imagePath;
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
    }

    function closePoster() {
        const modal = document.getElementById("posterModal");

        modal.style.display = "none";
        document.body.style.overflow = "";
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closePoster();
        }
    });
</script>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("[data-author-card]").forEach(card => {
                const openButton = card.querySelector("[data-author-open]");
                const closeButton = card.querySelector("[data-author-close]");
                const description = card.querySelector(".author-book-description");

                        const openCard = () => {
            card.classList.add("is-opening");

            window.setTimeout(() => {
                card.classList.add("is-open");
                openButton?.setAttribute("aria-expanded", "true");
                description?.setAttribute("aria-hidden", "false");
            }, 120);

            window.setTimeout(() => {
                card.classList.remove("is-opening");
                closeButton?.focus();
            }, 1020);
        };
                const closeCard = () => {
                    card.classList.remove("is-open");
                    openButton?.setAttribute("aria-expanded", "false");
                    description?.setAttribute("aria-hidden", "true");

                    window.setTimeout(() => {
                        openButton?.focus();
                    }, 300);
                };

                openButton?.addEventListener("click", openCard);
                closeButton?.addEventListener("click", closeCard);

                card.addEventListener("keydown", event => {
                    if (event.key === "Escape" && card.classList.contains("is-open")) {
                        closeCard();
                    }
                });
            });
        });
    </script>
}